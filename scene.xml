<!--
  Scene for checking the prosthetic arm in the MuJoCo viewer.
  Includes the arm and the 5 objects (cup, bottle, box, pen, ball).
-->
<mujoco model="prosthetic_arm_scene">
  <include file="prosthetic_arm.xml"/>
  <include file="objects.xml"/>

  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="140" elevation="-20" offwidth="1280" offheight="720"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.2 0.25 0.3" rgb2="0.3 0.35 0.4"/>
    <material name="grid" texture="grid" texrepeat="8 8" reflectance="0.1"/>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.4 0.6 0.8" rgb2="0 0 0"
             width="512" height="512"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="3 3 0.05" material="grid" contype="1" conaffinity="1"/>
    <!-- Reach zone: where objects are handed over (visual only, no collisions).
         Approach start points are 0.4-0.7 m away from this zone, in front of the arm. -->
    <site name="reach_zone" type="box" pos="0.45 -0.15 1.20" size="0.10 0.15 0.15" rgba="0.2 1 0.4 0.08"/>
    <!-- Fixed camera for the web app's live image stream -->
    <camera name="demo" pos="1.2 -1.2 1.7" mode="targetbody" target="forearm"/>
  </worldbody>
</mujoco>
